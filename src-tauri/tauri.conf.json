{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Odin Desktop",
  "version": "0.1.1",
  "identifier": "dev.odin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Odin Desktop",
        "width": 1280,
        "height": 880,
        "minWidth": 900,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "externalBin": [
      "binaries/odin4"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libusb-1.0-0",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64"
        ],
        "files": {
          "/usr/lib/udev/rules.d/60-odin-desktop.rules": "../packaging/udev/60-odin-desktop.rules"
        }
      },
      "rpm": {
        "depends": [
          "libusb1",
          "webkit2gtk4.1",
          "gtk3"
        ],
        "files": {
          "/usr/lib/udev/rules.d/60-odin-desktop.rules": "../packaging/udev/60-odin-desktop.rules"
        }
      }
    },
    "icon": [
      "icons/icon.png"
    ],
    "resources": [
      "binaries/ODIN4-LICENSE",
      "binaries/ODIN4-NOTICE"
    ],
    "shortDescription": "Samsung firmware flashing desktop application",
    "longDescription": "A native Linux desktop interface for Odin4 with local USB access, firmware validation and operation logs.",
    "category": "Utility"
  }
}
